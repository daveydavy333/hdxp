#!/bin/sh
# start hevel from a text console
# HEVEL_TIMEOUT=60 hevel-start  ends hevel after 60 seconds (safety net while testing)
# an executable /etc/hdxi/hevel-autostart (or $HEVEL_AUTOSTART) runs once hevel is up,
# e.g. to set a wallpaper:  wawa fill /usr/local/share/backgrounds/hdxi.png
: "${XDG_RUNTIME_DIR:=/tmp/xdg}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
export WLD_DRM_DUMB=1
if [ -n "${HEVEL_TIMEOUT:-}" ]; then
    ( sleep "$HEVEL_TIMEOUT"; pkill hevel ) >/dev/null 2>&1 &
fi
AUTOSTART="${HEVEL_AUTOSTART:-/etc/hdxi/hevel-autostart}"
if [ -x "$AUTOSTART" ]; then
    ( sleep 1; WAYLAND_DISPLAY=wayland-0 exec "$AUTOSTART" ) >/tmp/hevel-autostart.log 2>&1 &
fi
exec swc-launch hevel "$@"
