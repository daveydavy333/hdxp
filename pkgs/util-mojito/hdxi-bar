#!/bin/sh
# HDXI_BAR_GEOM / HDXI_BAR_FONT override the defaults, e.g. HDXI_BAR_GEOM=x24 hdxi-bar
GEOM="${HDXI_BAR_GEOM:-x24}"
FONT="${HDXI_BAR_FONT:-DejaVu Sans Mono:pixelsize=14}"
battery() {
    for b in /sys/class/power_supply/BAT*; do
        [ -r "$b/capacity" ] && printf '%s%%%% ' "$(cat "$b/capacity")"
    done
}
address() { ip -4 -o addr show scope global 2>/dev/null | awk '{print $4; exit}'; }
while :; do
    printf '%%{l} HDXI %%{c}%s%%{r}%s%s \n' "$(date '+%a %d %b  %H:%M')" "$(battery)" "$(address)"
    sleep 5
done | mojito -g "$GEOM" -f "$FONT" -B '#101830' -F '#c8d4ff' "$@"
