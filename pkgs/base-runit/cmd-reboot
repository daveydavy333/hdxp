#!/bin/sh
# reboot: under runit use runit-init, under dinit use dinit-reboot, under situation hand over to situation's own command
case "$(cat /proc/1/comm 2>/dev/null)" in
    runit*) exec runit-init 6 ;;
    dinit*) exec /usr/local/sbin/dinit-reboot "$@" ;;
    *)      exec /bin/reboot "$@" ;;
esac
